{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && node --experimental-strip-types --test src/modules/notes/richMarkdown.test.ts tests/notes-import.test.mjs tests/notes-loading.test.mjs tests/notes-keepalive.test.mjs",
    "test:e2e": "playwright test e2e/ --workers=1",
    "test:background": "vitest run --config vitest.background.config.mjs && node --test tests/background-player.test.mjs",
    "test:servers": "node --test src/modules/servers/taskWait.test.ts tests/server-state.test.mjs tests/metrics-compare.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@types/d3-force": "^3.0.10",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "live2d-widget": "^3.1.4",
    "live2d-widget-model-shizuku": "^1.0.5",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "pinia": "^4.0.2",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.8"
  }

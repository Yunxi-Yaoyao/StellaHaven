{
  "review": {
    "audit": "docs/api-response-feedback-review.md",
    "scope": {
      "main.py": "Only reserve /mtr-jobs alongside existing API prefixes; no mount/auth change.",
      "app/routers/monitor.py": "Four ordered /groups routes, current_user read and admin_user writes, 201/204 and string 400; real DTO output.",
      "app/schemas/monitor.py": "Nullable optional job_id, bounded MtrJobCreate and MonitorGroupWrite/Read; other schemas unchanged.",
      "app/models/task.py": "Add nullable indexed job_id only.",
      "app/repositories/task.py": "Advisory-locked atomic fan-out, no manual queue, trigger-scoped retention of completed tasks; pre-limit source filter.",
      "app/services/task.py": "Bounded unique online node fan-out with existing params validation; list trigger delegated.",
      "app/models/monitor.py": "Group/member tables only, FK cascading membership not child data.",
      "app/models/alert.py": "Archived rule partial uniqueness, snapshot/context/dedupe fields; notification link remains nullable.",
      "app/routers/alerts.py": "Incident list timezone/range422 and detail404, notification context and entity detail; auth inherited current_user.",
      "app/services/alerts.py": "Archive instead of delete, unknown resets consecutive, frozen transitions and exact incident notification contexts; SMTP remains existing explicit rule choice.",
      "app/routers/task.py": "Manual filter Literal, active conflict409, current_user one-shot /mtr-jobs and detail404.",
      "app/public_website.py": "Validated optional private_address and follow/public policy only.",
      "app/routers/website_settings.py": "Request-origin source for check/save and authenticated JS loader; response envelopes unchanged.",
      "app/services/website_settings.py": "Exact deployed private entry validation/probe; optional field persistence; no DNS/TLS/callback provisioning.",
      "app/services/website_templates.py": "Explicit exported editable dual registered parent origins; snapshot not runtime rewrite.",
      "app/services/website_assets.py": "Exact selected registered browser origin in authenticated asset payload.",
      "app/services/entry_registry.py": "Select registered private/public entry, preserve suffix and reject arbitrary private entry; isolated proxy restrictions.",
      "app/services/alert_metrics.py": "Exclude archived rules for save/list/dedupe/cap; serialization remains PublicMetricRule.",
      "app/routers/web_projects.py": "New owner workspace identities route; other handler signatures/shapes unchanged.",
      "app/services/web_projects.py": "Manifest corrupt metadata409; ancestry-only identities and optional guarded image hints.",
      "app/services/backup_archive.py": "Closed InvalidArchive reason lookup; resources ZIP_STORED, all validators unchanged.",
      "app/services/backup_center.py": "Closed failure code and execution stage, safe fixed log fields, nullable initial diagnostics, ownership fences preserved.",
      "app/schemas/backups.py": "Nullable ReasonCode/FailedStage on Job and nested Status, exact standalone serialization schema frozen.",
      "app/backup_diagnostics.py": "Reviewed closed reason and stage vocabulary; fixed guard labels only.",
      "app/services/backup_postgres.py": "Known PG client/dump errors become closed BackupFailure; command execution unchanged.",
      "app/services/alert_history.py": "Read-only adjacent transition projection before filter/pagination; incomplete gaps and raw internal notification context.",
      "app/services/monitor_groups.py": "Advisory serialized explicit membership CRUD; bounded unique children and no probe/history rewrite.",
      "app/services/notifications.py": "Trusted deduped terminal-result admission only, no new HTTP/auth; current JSONB writers do not validate legacy context."
    }
  },
